<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Identity\Domain\User" table="identity_user">
        <id name="id" type="identity_user_id"/>

        <field name="email" type="identity_email" unique="true"/>
        <field name="name" type="identity_user_name"/>
        <field name="passwordHash" type="string" length="255"/>
        <field name="roles" type="json"/>
        <field name="registeredAt" type="datetime_immutable"/>
    </entity>
</doctrine-mapping>
