{% extends 'base.html.twig' %}

{% block title %}Crear cuenta{% endblock %}

{% block body %}
    <h1>Crear cuenta</h1>

    {{ form_start(form, {action: path('identity_register')}) }}
        {{ form_errors(form) }}
        {{ form_row(form.name) }}
        {{ form_row(form.email) }}
        {{ form_row(form.password.first) }}
        {{ form_row(form.password.second) }}
        <button type="submit">Crear cuenta</button>
    {{ form_end(form) }}

    <p>¿Ya tienes cuenta? <a href="{{ path('identity_login') }}">Inicia sesión</a></p>
{% endblock %}
